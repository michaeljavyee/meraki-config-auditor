# Copy to .env and fill in. .env is gitignored and CI fails if it is ever tracked.
#
# Meraki Dashboard API key. Create one at:
#   Dashboard -> your profile (top right) -> My profile -> API access -> Generate new API key
# A key inherits the dashboard permissions of the admin who generated it.
# A read-only org admin is sufficient for every check in this tool, and is the
# right ask for anything other than your own lab.
#
# For a free live target, reserve the Cisco DevNet "Meraki Sandbox"
# (devnetsandbox.cisco.com). It gives you your own organization with virtual
# devices; generate a key inside that org. (The old shared always-on sandbox
# and its published key have been retired.)
MERAKI_API_KEY=

# Optional. If the key can see more than one organization, pick one by ID.
# Leave blank to use the only org the key can see (the tool refuses to guess
# when there are several).
MERAKI_ORG_ID=
